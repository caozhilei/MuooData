2018-10-04 23:32:08 [elasticsearch] DEBUG: > {"zhihu_id": 474125196, "url": "https://www.zhihu.com/api/v4/answers/474125196", "question_id": 64408536, "author_id": "069bc63194a3cca06361c7af44abc528", "content": "<p>有什么好评价的，漫画界的神啊。</p>", "praise_num": 0, "comments_num": 0, "create_time": "2018-08-21T09:40:37", "update_time": "2018-08-21T09:40:37", "crawl_time": "2018-10-04T23:32:08.535512"}
