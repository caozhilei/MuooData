2018-10-04 23:31:22 [elasticsearch] DEBUG: > {"zhihu_id": 458013931, "url": "https://www.zhihu.com/api/v4/answers/458013931", "question_id": 275029367, "author_id": "89d8142ba85bf36f34ea700324a3885a", "content": "<p>努力的前提是方向，《道德经》是说方向的书。</p>", "praise_num": 18, "comments_num": 3, "create_time": "2018-08-01T19:33:38", "update_time": "2018-08-01T19:33:38", "crawl_time": "2018-10-04T23:31:22.053881"}
