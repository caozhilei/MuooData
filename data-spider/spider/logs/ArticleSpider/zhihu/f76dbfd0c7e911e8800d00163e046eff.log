2018-10-04 23:30:29 [elasticsearch] DEBUG: > {"zhihu_id": 501450814, "url": "https://www.zhihu.com/api/v4/answers/501450814", "question_id": 275029367, "author_id": "6bbc9c99e6842584e4c60d61f5feb5e8", "content": "<p>没有努力 只有欲望</p>", "praise_num": 2, "comments_num": 0, "create_time": "2018-09-30T20:35:17", "update_time": "2018-09-30T22:04:18", "crawl_time": "2018-10-04T23:30:29.292894"}
