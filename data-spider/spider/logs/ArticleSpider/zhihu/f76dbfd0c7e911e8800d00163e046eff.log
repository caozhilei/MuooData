2018-10-04 23:31:10 [elasticsearch] DEBUG: > {"zhihu_id": 19231423, "url": "https://www.zhihu.com/api/v4/answers/19231423", "question_id": 19908102, "author_id": "e2ca906dcdb9b8579bd15fe4e4ac00fe", "content": "资源少+视野低=易满足，穷欢乐<br>资源少+视野高=身体累，精神累<br>资源多+视野低=有可能败家子<br>资源多+视野高=富贵代代相传", "praise_num": 1430, "comments_num": 103, "create_time": "2013-10-07T10:59:50", "update_time": "2013-10-07T10:59:50", "crawl_time": "2018-10-04T23:31:09.927754"}
